DATABASE_URL=sqlite:////workspace/media-aggregator/data/media_aggregator.db
BACKEND_CORS_ORIGINS=https://<pod-id>-3000.proxy.runpod.net,http://localhost:3000
ENABLE_DEMO_DATA=false

EVENT_REGISTRY_API_KEY=
X_BEARER_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_USE_GLOBAL_SEARCH=true
TELEGRAM_ALLOW_PAID_STARS=0
GUARDIAN_OPEN_PLATFORM_KEY=
GNEWS_API_KEY=
MEDIA_CLOUD_API_KEY=
NEWSDATA_API_KEY=
OPENAI_API_KEY=
ANALYSIS_MODE=hybrid
OPENAI_ENABLE_QUERY_EXPANSION=true
OPENAI_QUERY_EXPANSION_MODEL=gpt-5.4-mini
QUERY_EXPANSION_LANGUAGES=en,ru,ar,fa,tr,zh
OPENAI_ENRICHMENT_MODEL=gpt-5.4-mini
OPENAI_SYNTHESIS_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_LLM_ITEM_LIMIT=0
OPENAI_BATCH_CHUNK_SIZE=6
OPENAI_ENABLE_SYNTHESIS=true
OPENAI_ENABLE_SEMANTIC_CLUSTERING=true
OPENAI_ENABLE_SEMANTIC_RERANKING=true
OPENAI_EMBEDDING_DIMENSIONS=1024
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_ENABLE_QUOTE_REVIEW=true
TRANSLATION_PREVIEW_ENABLED=true
REPORT_DOCX_TEMPLATE_PATH=/workspace/media-aggregator/Шаблон.docx
NEXT_PUBLIC_API_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/api/v1
NEXT_PUBLIC_EXPORT_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/api/v1
