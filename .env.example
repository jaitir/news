POSTGRES_DB=media_aggregator
POSTGRES_USER=media_aggregator
POSTGRES_PASSWORD=media_aggregator
DATABASE_URL=postgresql+psycopg://media_aggregator:media_aggregator@db:5432/media_aggregator
BACKEND_CORS_ORIGINS=http://localhost:3000
ENABLE_DEMO_DATA=true
EVENT_REGISTRY_API_KEY=
X_BEARER_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_USE_GLOBAL_SEARCH=true
TELEGRAM_ALLOW_PAID_STARS=0
TELEGRAM_CURATED_CHANNELS=
GUARDIAN_OPEN_PLATFORM_KEY=
GNEWS_API_KEY=
MEDIA_CLOUD_API_KEY=
NEWSDATA_API_KEY=
X_CURATED_ACCOUNTS=
ENABLE_PIVOT_TRANSLATION=true
OPENAI_API_KEY=
ANALYSIS_MODE=hybrid
OPENAI_ENABLE_QUERY_EXPANSION=true
OPENAI_QUERY_EXPANSION_MODEL=gpt-5.4-mini
QUERY_EXPANSION_LANGUAGES=en,ru,ar,fa,tr,zh,es,fr,de,hi,pt
OPENAI_ENRICHMENT_MODEL=gpt-5.4-mini
OPENAI_SYNTHESIS_MODEL=gpt-5.4
OPENAI_DEEP_RESEARCH_MODEL=gpt-5.4-pro
OPENAI_DEEP_RESEARCH_REASONING_EFFORT=high
OPENAI_DEEP_RESEARCH_MAX_TOOL_CALLS=24
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_LLM_ITEM_LIMIT=24
OPENAI_BATCH_CHUNK_SIZE=6
OPENAI_ENABLE_SYNTHESIS=true
OPENAI_ENABLE_SEMANTIC_CLUSTERING=true
OPENAI_ENABLE_SEMANTIC_RERANKING=true
OPENAI_EMBEDDING_DIMENSIONS=1024
TRANSLATION_PREVIEW_ENABLED=true
TRANSLATION_PREVIEW_PROVIDER=mymemory
TRANSLATION_PREVIEW_ENDPOINT=
TRANSLATION_PREVIEW_API_KEY=
TRANSLATION_PREVIEW_CACHE_TTL_SECONDS=86400
